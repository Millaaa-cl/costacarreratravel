---
/** Plantilla para páginas de texto (cómo llegar, nosotros, términos, blog). */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { routes, type Lang, type RouteKey } from '../i18n/routes';
import { content } from '../i18n/content';
import { breadcrumbSchema, articleSchema } from '../lib/schema';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  title: string;            // <title>
  description: string;      // meta description
  h1: string;
  kicker?: string;
  lead?: string;
  parent?: { name: string; path: string };
  article?: { date: string; updated?: string };
  schema?: object[];
  noindex?: boolean;
  cta?: boolean;
}
const { lang, routeKey, title, description, h1, kicker, lead, parent, article, schema = [], noindex, cta = true } = Astro.props;
const t = content[lang];
const path = routes[routeKey][lang];
const crumbs = [{ name: lang === 'es' ? 'Inicio' : 'Home', path: routes.home[lang] }, ...(parent ? [parent] : []), { name: h1, path }];
const extra = [breadcrumbSchema(crumbs), ...(article ? [articleSchema({ title: h1, description, path, lang, ...article })] : []), ...schema];
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(lang === 'es' ? 'es-CL' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base lang={lang} title={title} description={description} routeKey={routeKey} schema={extra} noindex={noindex} ogType={article ? 'article' : 'website'}>
  <PageHero title={h1} kicker={kicker} lead={lead} crumbs={crumbs}>
    {article && <p style="font-size:.9rem;opacity:.8;margin-top:1rem;">{lang === 'es' ? 'Actualizado' : 'Updated'}: <time datetime={article.updated ?? article.date}>{fmt(article.updated ?? article.date)}</time></p>}
  </PageHero>
  <section class="section">
    <div class="container">
      <article class="prose"><slot /></article>
    </div>
  </section>
  {cta && (
    <section class="section section--deep cta-band">
      <div class="container">
        <h2>{t.cta.h}</h2>
        <p>{t.cta.p}</p>
        <a class="btn btn--primary" href={`${routes.tour[lang]}#reservar`}>{t.bookNow}</a>
      </div>
    </section>
  )}
</Base>
