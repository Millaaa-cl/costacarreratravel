---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import { content } from '../i18n/content';
import { routes, type Lang } from '../i18n/routes';
import { tour, formatCLP } from '../data/tour';
import { tourSchema, faqSchema } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const es = lang === 'es';
const seo = es
  ? { title: 'Tour Laguna San Rafael desde Puerto Río Tranquilo | Reserva online', description: `Full day en lancha rápida hasta el Glaciar San Rafael: traslados, desayuno, almuerzo y whisky con hielo milenario por ${formatCLP(tour.priceFromCLP)}. Reserva y paga online.` }
  : { title: 'San Rafael Lagoon Tour from Puerto Río Tranquilo | Book online', description: `Full-day speedboat tour to the San Rafael Glacier: transfers, breakfast, lunch and whisky on ancient glacier ice for ${formatCLP(tour.priceFromCLP)}. Book and pay online.` };
---
<Base lang={lang} title={seo.title} description={seo.description} routeKey="home"
  schema={[...tourSchema(lang, t.answer.p, t.itinerary.steps), faqSchema(t.faq)]}>
  <Hero lang={lang}
    over={es ? 'Navega entre icebergs hasta el' : 'Sail among icebergs to the'}
    title={es ? 'Glaciar San Rafael' : 'San Rafael Glacier'}
    lead={t.hero.lead}
    bookHref={`${routes.tour[lang]}#reservar`}
    secondary={{ href: `${routes.tour[lang]}#itinerario`, label: t.seeItinerary }} />
  <Sections lang={lang} show={['trust', 'answer', 'itinerary', 'parallax', 'includes', 'gallery', 'boat', 'reviews', 'faq', 'map', 'cta']} />
</Base>
