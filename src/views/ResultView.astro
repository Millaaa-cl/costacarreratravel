---
import Base from '../layouts/Base.astro';
import { content } from '../i18n/content';
import { routes, type Lang } from '../i18n/routes';
import { waLink } from '../data/tour';
import Icon from '../components/Icon.astro';

interface Props { lang: Lang; ok: boolean }
const { lang, ok } = Astro.props;
const t = content[lang];
const es = lang === 'es';
const copy = ok
  ? es
    ? { h: '¡Reserva confirmada!', p: 'Tu pago fue recibido. Te enviamos un correo con el detalle de tu reserva y las instrucciones para el día del tour. Si no lo ves, revisa la carpeta de spam.' }
    : { h: 'Booking confirmed!', p: 'Your payment was received. We have emailed you the booking details and instructions for tour day. If you cannot find it, check your spam folder.' }
  : es
    ? { h: 'El pago no se completó', p: 'No se realizó ningún cargo, o el pago fue rechazado. Tus cupos se liberarán en unos minutos. Puedes intentarlo de nuevo o escribirnos por WhatsApp.' }
    : { h: 'Payment not completed', p: 'No charge was made, or the payment was declined. Your seats will be released in a few minutes. You can try again or message us on WhatsApp.' };
---
<Base lang={lang} title={copy.h} description={copy.p} noindex mobileCta={false}
  alternates={{ es: ok ? routes.ok.es : routes.fail.es, en: ok ? routes.ok.en : routes.fail.en }}>
  <section class="section">
    <div class="container" style="max-width:640px;text-align:center">
      <div aria-hidden="true" style={`width:72px;height:72px;margin:0 auto 16px;border-radius:50%;display:grid;place-items:center;color:#fff;background:${ok ? 'var(--teal)' : 'var(--red)'}`}><Icon name={ok ? 'check' : 'x'} /></div>
      <h1 style="font-size:2.4rem">{copy.h}</h1>
      <p class="lead" style="margin-inline:auto">{copy.p}</p>
      <p data-code style="font-weight:600"></p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px">
        {ok
          ? <a class="btn btn--primary" href={routes.blog[lang]}>{es ? 'Prepara tu viaje' : 'Plan your trip'}</a>
          : <a class="btn btn--primary" href={`${routes.tour[lang]}#reservar`}>{es ? 'Intentar de nuevo' : 'Try again'}</a>}
        <a class="btn btn--ghost" style="color:var(--deep)" href={waLink(t.whatsappMsg)} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
<script>
  const params = new URLSearchParams(location.search);
  const code = params.get('codigo');
  const isEs = document.documentElement.lang.startsWith('es');
  const el = document.querySelector('[data-code]');
  if (code && el && /^[A-Z0-9-]{4,20}$/.test(code)) el.textContent = (isEs ? 'Código de reserva: ' : 'Booking code: ') + code;
  // Pago en proceso (por ejemplo, una transferencia aún no acreditada)
  if (params.get('estado') === 'pendiente') {
    const h1 = document.querySelector('h1');
    const lead = document.querySelector('.lead');
    if (h1) h1.textContent = isEs ? 'Pago en proceso' : 'Payment in progress';
    if (lead) lead.textContent = isEs
      ? 'Tu pago se está procesando. Te enviaremos la confirmación por correo apenas se acredite.'
      : 'Your payment is being processed. We will email your confirmation as soon as it clears.';
  }
</script>
